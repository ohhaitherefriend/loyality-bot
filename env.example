# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_here

# Admin Secret Code
ADMIN_SECRET_CODE=your_secret_code_here

# Database Configuration (для PostgreSQL)
DB_PASSWORD=your_secure_password_here

# JWT Secret (минимум 32 символа)
JWT_SECRET=your_jwt_secret_at_least_32_characters_long

# AES-256 Encryption Key for bot tokens (Base64)
# Сгенерируйте: TokenEncryptionService.generateKey()
ENCRYPTION_KEY=your_base64_encryption_key_here

# CORS: comma-separated list of allowed origins (for production)
# CORS_ALLOWED_ORIGINS=https://admin.yourdomain.com

# Optional: Port mapping
PORT=8080
