# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_here

# Admin Secret Code
ADMIN_SECRET_CODE=your_secret_code_here

# Database Configuration (для PostgreSQL)
DB_PASSWORD=your_secure_password_here

# Flyway baseline version for the `prod` profile (Stage 6/ADR-013). This is a one-time historical
# fact about the cutover from Hibernate ddl-auto to Flyway-managed schema - leave it at the default
# unless docs/DECISIONS.md ADR-013 tells you otherwise (e.g. restoring a very old backup).
# FLYWAY_BASELINE_VERSION=23

# JWT Secret (минимум 32 символа)
JWT_SECRET=your_jwt_secret_at_least_32_characters_long

# Stage 8 security hardening: comma-separated AdminUser emails allowed to call platform-wide
# (non-shop-scoped) endpoints: POST /api/admin/webhooks/update-all, GET /api/stats.
# Empty by default = nobody can call them (fail closed).
SYSTEM_ADMIN_EMAILS=

# AES-256 Encryption Key for bot tokens (Base64)
# Сгенерируйте: TokenEncryptionService.generateKey()
ENCRYPTION_KEY=your_base64_encryption_key_here

# CORS: comma-separated list of allowed origins (for production)
# CORS_ALLOWED_ORIGINS=https://admin.yourdomain.com

# Commerce image pipeline (set via env, do not commit real keys)
COMMERCE_IMAGE_SEARCH_ENABLED=false
COMMERCE_IMAGE_SEARCH_PROVIDER=disabled
BRAVE_SEARCH_API_KEY=
COMMERCE_IMAGE_RANKER=rule-based
DEEPSEEK_API_KEY=
COMMERCE_BACKGROUND_REMOVAL_PROVIDER=disabled
REMBG_URL=http://localhost:7000/remove
REMBG_HEALTH_URL=http://localhost:7000/health

# Supplier import: DeepSeek AI (layout detection + catalog matcher, docs/ARCHITECTURE.md §10/§21).
# Optional - app starts fine and AI stages no-op (quarantine/NEEDS_REVIEW) if SUPPLIER_IMPORT_DEEPSEEK_API_KEY is unset.
SUPPLIER_IMPORT_DEEPSEEK_API_KEY=
SUPPLIER_IMPORT_DEEPSEEK_MODEL=deepseek-v4-flash
SUPPLIER_IMPORT_DEEPSEEK_BASE_URL=https://api.deepseek.com
SUPPLIER_IMPORT_DEEPSEEK_CONNECT_TIMEOUT_MS=5000
SUPPLIER_IMPORT_DEEPSEEK_TIMEOUT_MS=20000
SUPPLIER_IMPORT_DEEPSEEK_MAX_RETRIES=2
SUPPLIER_IMPORT_DEEPSEEK_RETRY_BACKOFF_MS=500
SUPPLIER_IMPORT_DEEPSEEK_MAX_CONCURRENT_REQUESTS=4
SUPPLIER_IMPORT_DEEPSEEK_CONCURRENCY_ACQUIRE_TIMEOUT_MS=3000
SUPPLIER_IMPORT_DEEPSEEK_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
SUPPLIER_IMPORT_DEEPSEEK_CIRCUIT_BREAKER_OPEN_DURATION_MS=30000

# Supplier import file storage (Stage 10, docs/DECISIONS.md ADR-014). "local" (default) writes
# under SUPPLIER_IMPORT_STORAGE_PATH on whichever host runs the container - fine for a single
# `app` replica, but REQUIRED to be "s3" if you ever run more than one replica, since a local
# path is not shared between them.
SUPPLIER_IMPORT_STORAGE_PATH=./data/import-files
SUPPLIER_IMPORT_STORAGE_PROVIDER=local
SUPPLIER_IMPORT_S3_BUCKET=
SUPPLIER_IMPORT_S3_REGION=eu-central-1
# Leave blank for real AWS S3; set to a compatible endpoint (e.g. MinIO, R2) otherwise.
SUPPLIER_IMPORT_S3_ENDPOINT=
SUPPLIER_IMPORT_S3_ACCESS_KEY_ID=
SUPPLIER_IMPORT_S3_SECRET_ACCESS_KEY=
SUPPLIER_IMPORT_S3_PATH_STYLE_ACCESS=false
SUPPLIER_IMPORT_S3_KEY_PREFIX=

# Supplier import file retention (Stage 10, docs/DECISIONS.md ADR-015). Opt-in deletion of the
# original price-file blob (not the parsed rows/offers) for terminal batches past this many days.
# Disabled by default.
SUPPLIER_IMPORT_RETENTION_ENABLED=false
SUPPLIER_IMPORT_RETENTION_FILE_DAYS=180

# Optional: Port mapping
PORT=8080
