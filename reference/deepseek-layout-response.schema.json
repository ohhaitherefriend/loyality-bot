{
  "$comment": "This file is a reference copy of the ACTUAL runtime schema at src/main/resources/supplier-import/layout-rule.schema.json (loaded by LayoutRuleValidator). It previously described a different, stale response shape (snake_case sheet_selectors/header_row/first_data_row/columns) that no longer matches DeepSeekSpreadsheetLayoutDetector's real prompt/response contract - keep this file in sync with the runtime resource, or delete it, rather than letting it drift again.",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://plstk.com/schemas/supplier-import/layout-rule.schema.json",
  "title": "SupplierLayoutRule",
  "description": "Strict, closed-vocabulary column mapping rule produced either by AiSpreadsheetLayoutDetector or by a human. No arbitrary SpEL/JavaScript/SQL is representable in this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sheetSelectors", "headerRow", "firstDataRow", "columns"],
  "properties": {
    "sheetSelectors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 255 }
    },
    "headerRow": { "type": "integer", "minimum": 1, "maximum": 200 },
    "firstDataRow": { "type": "integer", "minimum": 1, "maximum": 201 },
    "columns": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "externalSku": { "$ref": "#/definitions/columnMapping" },
        "barcode": { "$ref": "#/definitions/columnMapping" },
        "rawName": { "$ref": "#/definitions/columnMapping" },
        "brand": { "$ref": "#/definitions/columnMapping" },
        "supplierPrice": { "$ref": "#/definitions/columnMapping" },
        "stock": { "$ref": "#/definitions/columnMapping" }
      }
    },
    "skipRules": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["column", "matches"],
        "properties": {
          "column": {
            "type": "string",
            "enum": ["externalSku", "barcode", "rawName", "brand", "supplierPrice", "stock"]
          },
          "matches": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": { "type": "string", "maxLength": 100 }
    },
    "expectedHeaderSignature": {
      "description": "Backend-populated only (see LayoutRuleDefinition javadoc) - never present in a fresh AI response, but present once a rule has been stored and is being re-validated on reuse (ImportBatchParsingService#parseStoredRule), so the schema must allow it here.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  },
  "definitions": {
    "columnMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headerAliases", "type"],
      "properties": {
        "headerAliases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "type": { "type": "string", "enum": ["STRING", "DECIMAL", "INTEGER", "BARCODE"] },
        "required": { "type": "boolean" }
      }
    }
  }
}
